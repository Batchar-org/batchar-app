{
  "expo": {
    "name": "batchar-app",
    "slug": "batchar-app",
    "version": "1.0.0",
    "scheme": "batchar-app",
    "web": {
      "favicon": "./assets/public/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "orientation": "portrait",
    "icon": "./assets/public/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/public/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
